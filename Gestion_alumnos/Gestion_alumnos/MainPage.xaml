<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Nómina de estudiantes"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                x:Name="TotalLabel"
                Text="{Binding TotalTexto}"
                FontSize="18" />

            <Label
                Text="Cargar nuevo estudiante"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                x:Name="ApellidoEntry"
                Placeholder="Apellido"
                Text="{Binding Apellido, Mode=TwoWay}" />
   
            <Entry
                x:Name="NombreEntry"
                Placeholder="Nombre"
                Text="{Binding Nombre, Mode=TwoWay}" />

            <Entry
                x:Name="LegajoEntry"
                Placeholder="Legajo"
                Keyboard="Numeric"
                Text="{Binding Legajo, Mode=TwoWay}" />

            <Picker
                x:Name="ComisionPicker"
                Title="Seleccione una comisión"
                SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}"
                >

                <Picker.Items>
                    <x:String>1°A</x:String>
                    <x:String>1°B</x:String>
                    <x:String>2°A</x:String>
                </Picker.Items>

            </Picker>

            <Button
    Text="AGREGAR ESTUDIANTE"
    Command="{Binding AgregarEstudianteCommand}" />

            <Label
                Text="Estudiantes cargados"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,20,0,0" />

            <Label
                x:Name="MensajeVacioLabel"
                Text="Esta comisión todavía no tiene estudiantes cargados."
                IsVisible="{Binding MostrarMensajeVacio}"
                TextColor="Gray" />

            <CollectionView
                ItemsSource="{Binding EstudiantesVisibles}"
                HeightRequest="350">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">

                            <Label
                                Text="{Binding Apellido}"
                                FontAttributes="Bold"
                                FontSize="18" />

                            <Label
                                Text="{Binding Nombre}" />

                            <Label
                                Text="{Binding Legajo}" />

                            <Label
                                Text="{Binding Comision}" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>