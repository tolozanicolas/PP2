<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.AsistenciaPage"
    Title="Asistencia">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Registro de asistencia"
            FontSize="26"
            FontAttributes="Bold" />

        <Label
            Text="Seleccione una comisión"
            FontSize="18" />

        <Picker
            x:Name="ComisionPicker"
            Title="Comisión"
            SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}">

            <Picker.Items>
                <x:String>1°A</x:String>
                <x:String>1°B</x:String>
                <x:String>2°A</x:String>
            </Picker.Items>

        </Picker>

        <Label
            Text="Seleccione una clase"
            FontSize="18" />

        <Picker
            x:Name="ClasePicker"
            Title="Fecha de clase"
            ItemsSource="{Binding ClasesDisponibles}"
            SelectedItem="{Binding ClaseSeleccionada, Mode=TwoWay}"
            ItemDisplayBinding="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" />

        <Label
            Text="Estudiantes de la comisión"
            FontSize="20"
            FontAttributes="Bold" />

        <Label
            x:Name="MensajeVacioLabel"
            Text="{Binding MensajeEstado}"
            TextColor="Gray" />

        <CollectionView
            x:Name="ListaEstudiantes"
            ItemsSource="{Binding EstudiantesAsistencia}"
            VerticalOptions="FillAndExpand">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid
                        Padding="10"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">

                        <Label
                            Grid.Column="0"
                            Text="{Binding NombreCompleto}"
                            VerticalOptions="Center"
                            FontSize="16" />

                        <CheckBox
                            Grid.Column="1"
                            IsChecked="{Binding Presente, Mode=TwoWay}" />

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            x:Name="GuardarButton"
            Text="GUARDAR ASISTENCIA"
            Command="{Binding GuardarAsistenciaCommand}"
            IsEnabled="{Binding PuedeGuardar}" />

    </VerticalStackLayout>

</ContentPage>